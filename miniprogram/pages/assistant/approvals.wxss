.approval-page { min-height: 100vh; padding: 32rpx 30rpx 60rpx; box-sizing: border-box; background: #f5f8f6; }.approval-heading { display: flex; flex-direction: column; gap: 7rpx; }.approval-heading > text { color: #6c897a; font-size: 18rpx; letter-spacing: 3rpx; }.approval-heading strong { color: #263a30; font-size: 40rpx; }.approval-heading small { color: #87928d; font-size: 21rpx; }.approval-list { margin-top: 28rpx; display: grid; gap: 18rpx; }.approval-card { padding: 22rpx; border-radius: 17rpx; background: white; }.approval-top { display: flex; align-items: center; justify-content: space-between; }.approval-top > text { color: #969f9b; font-size: 17rpx; }.request-type { width: fit-content; padding: 6rpx 11rpx; border-radius: 6rpx; color: #986337; background: #f4e9dc; font-size: 18rpx; }.type-退回 { color: #4c7662; background: #e6f0eb; }.type-报损 { color: #a15249; background: #f6e6e4; }.approval-main { margin-top: 20rpx; display: grid; grid-template-columns: 58rpx 1fr auto; align-items: start; gap: 14rpx; }.employee-avatar { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #4c7863; background: #e6f0eb; font-size: 21rpx; font-weight: 700; }.approval-main > view:nth-child(2) { display: flex; flex-direction: column; gap: 5rpx; }.approval-main > view:nth-child(2) strong { color: #2d4036; font-size: 23rpx; }.approval-main text,.approval-main p { margin: 0; color: #86918b; font-size: 19rpx; line-height: 1.5; }.approval-main > strong { color: #9c5a45; font-size: 24rpx; }.approval-actions { margin-top: 22rpx; display: flex; justify-content: flex-end; gap: 12rpx; }.approval-actions button { min-width: 130rpx; height: 64rpx; margin: 0; padding: 0 20rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #dce4e0; border-radius: 9rpx; color: #6f7a74; background: white; font-size: 21rpx; }.approval-actions button::after { border: 0; }.approval-actions button.approve { border-color: #477661; color: white; background: #477661; }.approval-empty { padding-top: 180rpx; display: flex; align-items: center; flex-direction: column; gap: 13rpx; color: #8c9791; }.approval-empty > view { width: 78rpx; height: 78rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #4f7b66; background: #e5efe9; font-size: 34rpx; }.approval-empty strong { color: #43544b; font-size: 27rpx; }.approval-empty text { font-size: 20rpx; }
