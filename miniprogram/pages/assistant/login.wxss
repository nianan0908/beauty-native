.login-page { min-height: 100vh; padding: 54rpx 38rpx calc(env(safe-area-inset-bottom) + 40rpx); box-sizing: border-box; background: linear-gradient(180deg,#edf4f0,#f8faf8 45%); }
.assistant-brand { display: flex; align-items: center; gap: 16rpx; color: #294036; font-size: 29rpx; font-weight: 700; }.assistant-brand > view { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: white; background: #477661; font-size: 25rpx; }
.login-copy { margin: 78rpx 0 42rpx; display: flex; flex-direction: column; gap: 12rpx; }.login-copy > text:first-child { color: #6d8f7e; font-size: 18rpx; letter-spacing: 3rpx; }.login-copy > view { color: #25372f; font-size: 48rpx; font-weight: 720; }.login-copy > text:last-child { color: #7d8983; font-size: 25rpx; }
.role-list { display: grid; gap: 16rpx; }.role-card { width: 100%; min-height: 126rpx; margin: 0; padding: 20rpx; display: grid; grid-template-columns: 72rpx 1fr 34rpx; align-items: center; gap: 20rpx; border: 2rpx solid transparent; border-radius: 18rpx; background: white; text-align: left; box-shadow: 0 10rpx 32rpx rgba(45,64,55,.06); }.role-card::after { border: 0; }.role-card.selected { border-color: #5a8973; background: #f8fcfa; }.role-avatar { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; color: #477661; background: #e4f0ea; font-size: 27rpx; font-weight: 700; }.role-card > view:nth-child(2) { display: flex; flex-direction: column; gap: 5rpx; }.role-card text { color: #839089; font-size: 19rpx; }.role-card strong { color: #293a32; font-size: 29rpx; }.role-card small { color: #8a948f; font-size: 20rpx; }.role-check { color: #4e8069; font-size: 30rpx; }
.password-field { margin-top: 34rpx; display: grid; gap: 10rpx; }.password-field text { color: #69766f; font-size: 21rpx; font-weight: 650; }.password-field input { height: 86rpx; padding: 0 24rpx; border: 1rpx solid #dce5e0; border-radius: 12rpx; background: white; font-size: 25rpx; }.login-error { display: block; margin-top: 14rpx; color: #a55149; font-size: 22rpx; }.login-button { height: 88rpx; margin-top: 32rpx; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; color: white; background: #477661; font-size: 27rpx; font-weight: 650; }.login-button::after { border: 0; }.login-tip { display: block; margin-top: 18rpx; color: #9aa39f; font-size: 19rpx; text-align: center; }
