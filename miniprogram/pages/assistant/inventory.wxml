<view class="inventory-page">
  <view class="inventory-heading"><view><text>CONSUMABLE INVENTORY</text><strong>{{user.role === 'employee' ? '我的耗材' : '耗材管理'}}</strong><small>{{user.role === 'owner' ? '全部门店库存' : user.storeName}}</small></view><button wx:if="{{user.role === 'employee'}}" bindtap="openRequest">＋ 申请</button></view>
  <view class="inventory-tabs"><button wx:if="{{user.role !== 'employee'}}" class="{{tab === 'stock' ? 'active' : ''}}" data-tab="stock" bindtap="changeTab">库存概览</button><button class="{{tab === 'records' ? 'active' : ''}}" data-tab="records" bindtap="changeTab">{{user.role === 'employee' ? '我的记录' : '库存流水'}}</button></view>
  <view wx:if="{{tab === 'stock'}}" class="stock-list"><view wx:for="{{stocks}}" wx:key="stockKey" class="stock-card"><view class="stock-icon">{{item.initial}}</view><view class="stock-copy"><strong>{{item.name}}</strong><text>{{item.store_name || item.store_id}} · {{item.category}}</text><small>安全库存 {{item.safety_stock}}{{item.unit}}</small></view><view class="stock-quantity {{item.low ? 'low' : ''}}"><strong>{{item.quantity}}</strong><text>{{item.unit}}</text><small>{{item.low ? '需补货' : '库存正常'}}</small></view></view></view>
  <view wx:else class="transaction-list"><view wx:for="{{transactions}}" wx:key="id" class="transaction-card"><view class="transaction-type type-{{item.type}}">{{item.type}}</view><view><strong>{{item.consumable_name || item.consumable_id}}</strong><text>{{item.reason || '标准服务用量'}}</text><small>{{item.created_at}} · {{item.status}}</small></view><strong class="transaction-number">{{item.change > 0 ? '+' : ''}}{{item.change}}{{item.unit}}</strong></view><view wx:if="{{!transactions.length}}" class="empty-state">暂无耗材记录</view></view>

  <view wx:if="{{requestOpen}}" class="sheet-mask" bindtap="closeRequest"></view>
  <view wx:if="{{requestOpen}}" class="request-sheet"><view class="sheet-head"><view><text>CONSUMABLE REQUEST</text><strong>提交耗材申请</strong></view><button bindtap="closeRequest">×</button></view><view class="request-form"><label><text>申请类型</text><picker mode="selector" range="{{requestTypes}}" bindchange="selectType"><view>{{requestType}} ›</view></picker></label><label><text>选择耗材</text><picker mode="selector" range="{{stocks}}" range-key="name" bindchange="selectStock"><view>{{selectedStock.name || '请选择'}} ›</view></picker></label><label><text>数量（{{selectedStock.unit}}）</text><input type="digit" value="{{quantity}}" bindinput="inputQuantity" /></label><label><text>原因说明</text><textarea maxlength="300" placeholder="请说明额外领用、退回或报损原因" value="{{reason}}" bindinput="inputReason" /></label></view><text class="request-tip">提交后由店长审批，通过后才会变更门店库存。</text><button class="submit-request" bindtap="submitRequest">提交店长审批</button></view>
</view>
