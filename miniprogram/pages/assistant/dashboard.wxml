<view wx:if="{{user}}" class="assistant-page dashboard-page">
  <view class="assistant-header">
    <view><text>{{user.storeName}}</text><text class="strong">{{user.role === 'employee' ? '早上好，' + user.name : user.role === 'manager' ? '今日门店运营' : '品牌经营概览'}}</text><text class="small">{{metrics.headline}}</text></view>
    <button bindtap="switchRole"><view>{{user.initial}}</view><text>切换</text></button>
  </view>

  <view class="metric-grid">
    <view class="metric-card primary"><text>{{metrics.primaryLabel}}</text><text class="strong">{{metrics.primary}}</text><text class="small">{{user.role === 'employee' ? '查看今日安排' : '实时经营数据'}}</text></view>
    <view class="metric-card"><text>{{metrics.secondaryLabel}}</text><text class="strong">{{metrics.secondary}}</text><text class="small">{{user.role === 'owner' ? '全部门店' : user.storeName}}</text></view>
  </view>

  <view class="quick-actions">
    <button bindtap="openWork"><view class="quick-icon work">今</view><text>{{user.role === 'employee' ? '我的服务' : '今日预约'}}</text><text class="small">{{appointments.length}} 项安排</text></button>
    <button bindtap="openInventory"><view class="quick-icon stock">耗</view><text>{{user.role === 'employee' ? '耗材申请' : '库存管理'}}</text><text class="small">{{metrics.lowStock}} 项需关注</text></button>
    <button wx:if="{{user.role !== 'employee'}}" bindtap="openApprovals"><view class="quick-icon approval">审</view><text>待我审批</text><text class="small">{{metrics.pending}} 项待处理</text></button>
    <button wx:else bindtap="openInventory"><view class="quick-icon approval">流</view><text>我的记录</text><text class="small">领用与报损</text></button>
  </view>

  <view class="section-head"><view><text class="strong">{{user.role === 'employee' ? '我的服务' : '今日预约'}}</text><text>8月14日 · 星期五</text></view><button bindtap="openWork">全部 ›</button></view>
  <view class="appointment-list">
    <button wx:for="{{appointments}}" wx:key="id" bindtap="openWork">
      <view class="time-box"><text class="strong">{{item.time}}</text><text>{{item.status}}</text></view>
      <view class="appointment-copy"><text class="strong">{{item.customer}}</text><text>{{item.service}}</text><text class="small" wx:if="{{user.role !== 'employee'}}">服务员工 · {{item.employee}}</text></view>
      <view class="row-arrow">›</view>
    </button>
    <view wx:if="{{!appointments.length && !loading}}" class="empty-card">今天暂时没有服务安排</view>
  </view>

  <button wx:if="{{user.role !== 'employee' && metrics.lowStock}}" class="attention-card" bindtap="openInventory"><view>!</view><text><text class="strong">{{metrics.lowStock}} 项耗材需要关注</text><text class="small">库存低于安全库存，请及时处理</text></text><view>›</view></button>
</view>
