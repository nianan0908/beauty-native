<view class="login-page">
  <view class="assistant-brand"><view>栖</view><text>栖光门店助手</text></view>
  <view class="login-copy"><text>MERCHANT ASSISTANT</text><view>欢迎回到门店</view><text>选择身份，进入今天的工作台。</text></view>
  <view class="role-list">
    <button wx:for="{{accounts}}" wx:key="role" data-index="{{index}}" class="role-card {{selected === index ? 'selected' : ''}}" bindtap="selectRole">
      <view class="role-avatar">{{item.initial}}</view>
      <view><text>{{item.roleName}}</text><strong>{{item.name}}</strong><small>{{item.title}} · {{item.storeName}}</small></view>
      <view class="role-check">{{selected === index ? '✓' : ''}}</view>
    </button>
  </view>
  <view class="password-field"><text>登录密码</text><input password value="{{password}}" placeholder="请输入密码" bindinput="inputPassword" /></view>
  <text wx:if="{{error}}" class="login-error">{{error}}</text>
  <button class="login-button" bindtap="login">进入门店助手</button>
  <text class="login-tip">演示账号密码均为 demo123</text>
</view>
