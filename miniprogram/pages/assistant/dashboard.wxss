.assistant-page { min-height: 100vh; padding: 34rpx 30rpx calc(env(safe-area-inset-bottom) + 42rpx); box-sizing: border-box; background: #f5f8f6; }
.assistant-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }.assistant-header > view { display: flex; flex-direction: column; gap: 8rpx; }.assistant-header > view text { color: #698677; font-size: 20rpx; }.assistant-header > view strong { color: #25382f; font-size: 42rpx; }.assistant-header > view small { color: #88938e; font-size: 23rpx; }.assistant-header > button { margin: 0; padding: 0; display: flex; align-items: center; flex-direction: column; gap: 5rpx; background: transparent; color: #7c8882; font-size: 18rpx; }.assistant-header > button::after { border: 0; }.assistant-header > button view { width: 62rpx; height: 62rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: white; background: #4c7a65; font-size: 24rpx; font-weight: 700; }
.metric-grid { margin-top: 42rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }.metric-card { min-height: 180rpx; padding: 26rpx; display: flex; flex-direction: column; gap: 13rpx; border: 1rpx solid #e1e8e4; border-radius: 20rpx; background: white; box-shadow: 0 12rpx 38rpx rgba(38,59,49,.05); }.metric-card.primary { color: white; background: linear-gradient(145deg,#4f806a,#38614f); }.metric-card text { color: #7b8781; font-size: 21rpx; }.metric-card.primary text,.metric-card.primary small { color: #d5e3dc; }.metric-card strong { color: #263930; font-size: 40rpx; }.metric-card.primary strong { color: white; }.metric-card small { margin-top: auto; color: #909a95; font-size: 19rpx; }
.quick-actions { margin-top: 20rpx; padding: 20rpx 8rpx; display: grid; grid-template-columns: repeat(3,1fr); border: 1rpx solid #e1e8e4; border-radius: 20rpx; background: white; }.quick-actions button { margin: 0; padding: 9rpx; display: flex; align-items: center; flex-direction: column; gap: 8rpx; background: transparent; line-height: 1.3; }.quick-actions button::after { border: 0; }.quick-icon { width: 66rpx; height: 66rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; font-size: 23rpx; font-weight: 700; }.quick-icon.work { color: #4d7663; background: #e6f0eb; }.quick-icon.stock { color: #9a6c34; background: #f5eadb; }.quick-icon.approval { color: #7c627e; background: #eee5ef; }.quick-actions text { color: #33453c; font-size: 22rpx; font-weight: 650; }.quick-actions small { color: #929c97; font-size: 17rpx; }
.section-head { margin: 42rpx 4rpx 18rpx; display: flex; align-items: flex-end; justify-content: space-between; }.section-head > view { display: flex; flex-direction: column; gap: 5rpx; }.section-head strong { color: #2c3e35; font-size: 29rpx; }.section-head text { color: #8b9690; font-size: 19rpx; }.section-head button { margin: 0; padding: 0; color: #567e6b; background: transparent; font-size: 21rpx; }.section-head button::after { border: 0; }
.appointment-list { display: grid; gap: 12rpx; }.appointment-list > button { width: 100%; min-height: 124rpx; margin: 0; padding: 20rpx; display: grid; grid-template-columns: 96rpx 1fr 20rpx; align-items: center; gap: 18rpx; border-radius: 16rpx; background: white; text-align: left; }.appointment-list > button::after { border: 0; }.time-box { align-self: stretch; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 8rpx; border-right: 1rpx solid #e7ece9; }.time-box strong { color: #385c4c; font-size: 27rpx; }.time-box text { padding: 3rpx 7rpx; border-radius: 5rpx; color: #577b69; background: #e8f1ec; font-size: 16rpx; }.appointment-copy { display: flex; flex-direction: column; gap: 5rpx; }.appointment-copy strong { color: #2e4037; font-size: 25rpx; }.appointment-copy text { color: #69766f; font-size: 21rpx; }.appointment-copy small { color: #949d99; font-size: 18rpx; }.row-arrow { color: #96a19b; font-size: 34rpx; }.empty-card { padding: 70rpx 20rpx; border-radius: 16rpx; background: white; color: #929c97; font-size: 22rpx; text-align: center; }
.attention-card { width: 100%; min-height: 104rpx; margin: 20rpx 0 0; padding: 18rpx; display: grid; grid-template-columns: 56rpx 1fr 20rpx; align-items: center; gap: 14rpx; border: 1rpx solid #ead8c2; border-radius: 16rpx; background: #fff9f1; text-align: left; }.attention-card::after { border: 0; }.attention-card > view:first-child { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: white; background: #bd7d42; font-size: 25rpx; font-weight: 700; }.attention-card text { display: flex; flex-direction: column; gap: 6rpx; }.attention-card strong { color: #705037; font-size: 23rpx; }.attention-card small { color: #9a826c; font-size: 18rpx; }.attention-card > view:last-child { color: #a27a55; font-size: 32rpx; }
