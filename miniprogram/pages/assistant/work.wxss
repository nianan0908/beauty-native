.work-page { min-height: 100vh; padding: 32rpx 30rpx 50rpx; box-sizing: border-box; background: #f5f8f6; }.work-heading { display: flex; flex-direction: column; gap: 8rpx; }.work-heading text { color: #6c897a; font-size: 18rpx; letter-spacing: 3rpx; }.work-heading strong { color: #263a30; font-size: 42rpx; }.work-heading small { color: #87928d; font-size: 22rpx; }.work-list { margin-top: 28rpx; display: grid; gap: 20rpx; }.work-card { padding: 24rpx; border: 1rpx solid #e0e8e3; border-radius: 18rpx; background: white; }.work-card-top { display: flex; align-items: center; justify-content: space-between; }.work-card-top > view { display: flex; align-items: center; gap: 12rpx; }.work-card-top strong { color: #345948; font-size: 30rpx; }.work-card-top text { padding: 5rpx 9rpx; border-radius: 6rpx; color: #527460; background: #e8f1ec; font-size: 17rpx; }.work-card-top small { color: #a0aaa5; font-size: 17rpx; }.work-customer { margin-top: 22rpx; display: flex; align-items: center; gap: 16rpx; }.work-customer > view { width: 62rpx; height: 62rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #4f7865; background: #e6f0eb; font-size: 23rpx; font-weight: 700; }.work-customer > text { display: flex; flex-direction: column; gap: 5rpx; }.work-customer strong { color: #2e4037; font-size: 25rpx; }.work-customer small { color: #838e88; font-size: 20rpx; }.standard-stock { margin-top: 22rpx; padding: 16rpx; border-radius: 10rpx; background: #f5f8f6; }.standard-stock > text { color: #63736b; font-size: 20rpx; font-weight: 650; }.standard-stock > view { margin-top: 10rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }.standard-stock > view text { padding: 5rpx 9rpx; border-radius: 6rpx; color: #668173; background: #e6efea; font-size: 18rpx; }.work-actions { margin-top: 22rpx; display: flex; justify-content: flex-end; gap: 12rpx; }.work-actions button { min-width: 150rpx; height: 66rpx; margin: 0; padding: 0 20rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #d9e3dd; border-radius: 9rpx; color: #577164; background: white; font-size: 21rpx; }.work-actions button::after { border: 0; }.work-actions button.main { border-color: #477661; color: white; background: #477661; }
