.inventory-page { min-height: 100vh; padding: 32rpx 30rpx 60rpx; box-sizing: border-box; background: #f5f8f6; }.inventory-heading { display: flex; align-items: flex-end; justify-content: space-between; }.inventory-heading > view { display: flex; flex-direction: column; gap: 7rpx; }.inventory-heading text { color: #6c897a; font-size: 18rpx; letter-spacing: 3rpx; }.inventory-heading strong { color: #263a30; font-size: 40rpx; }.inventory-heading small { color: #87928d; font-size: 21rpx; }.inventory-heading button { height: 64rpx; margin: 0; padding: 0 20rpx; display: flex; align-items: center; border-radius: 9rpx; color: white; background: #477661; font-size: 21rpx; }.inventory-heading button::after { border: 0; }.inventory-tabs { margin-top: 32rpx; display: flex; gap: 12rpx; border-bottom: 1rpx solid #dfe7e2; }.inventory-tabs button { height: 72rpx; margin: 0; padding: 0 20rpx; position: relative; color: #7d8983; background: transparent; font-size: 22rpx; }.inventory-tabs button::after { border: 0; }.inventory-tabs button.active { color: #416c58; font-weight: 700; }.inventory-tabs button.active::before { content: ''; position: absolute; right: 16rpx; bottom: 0; left: 16rpx; height: 4rpx; border-radius: 2rpx; background: #477661; }.stock-list,.transaction-list { margin-top: 22rpx; display: grid; gap: 12rpx; }.stock-card { min-height: 124rpx; padding: 20rpx; display: grid; grid-template-columns: 68rpx 1fr auto; align-items: center; gap: 17rpx; border-radius: 15rpx; background: white; }.stock-icon { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; color: #4c7863; background: #e6f0eb; font-size: 23rpx; font-weight: 700; }.stock-copy { display: flex; flex-direction: column; gap: 5rpx; }.stock-copy strong { color: #2d4036; font-size: 24rpx; }.stock-copy text,.stock-copy small { color: #8a948f; font-size: 18rpx; }.stock-quantity { display: grid; justify-items: end; gap: 3rpx; }.stock-quantity strong { color: #355d4a; font-size: 29rpx; }.stock-quantity text { color: #7e8b84; font-size: 18rpx; }.stock-quantity small { color: #56806d; font-size: 17rpx; }.stock-quantity.low strong,.stock-quantity.low small { color: #ad6149; }.transaction-card { min-height: 118rpx; padding: 20rpx; display: grid; grid-template-columns: 68rpx 1fr auto; align-items: center; gap: 16rpx; border-radius: 15rpx; background: white; }.transaction-type { width: 64rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; border-radius: 9rpx; color: #996135; background: #f5eadd; font-size: 17rpx; }.type-退回 { color: #4d7863; background: #e6f0eb; }.type-报损 { color: #a45249; background: #f6e7e4; }.transaction-card > view:nth-child(2) { display: flex; flex-direction: column; gap: 5rpx; }.transaction-card > view:nth-child(2) strong { color: #2e4037; font-size: 23rpx; }.transaction-card text,.transaction-card small { color: #89938e; font-size: 18rpx; }.transaction-number { color: #a05c49; font-size: 22rpx; }.empty-state { padding: 100rpx 20rpx; color: #929d97; text-align: center; font-size: 22rpx; }.sheet-mask { position: fixed; z-index: 20; inset: 0; background: rgba(25,38,31,.35); }.request-sheet { padding: 30rpx 30rpx calc(env(safe-area-inset-bottom) + 28rpx); position: fixed; z-index: 21; right: 0; bottom: 0; left: 0; border-radius: 28rpx 28rpx 0 0; background: white; }.sheet-head { display: flex; align-items: flex-start; justify-content: space-between; }.sheet-head > view { display: flex; flex-direction: column; gap: 7rpx; }.sheet-head text { color: #6a8b7a; font-size: 17rpx; letter-spacing: 2rpx; }.sheet-head strong { color: #293b32; font-size: 32rpx; }.sheet-head button { width: 58rpx; height: 58rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #76827c; background: #f0f4f2; font-size: 34rpx; }.sheet-head button::after { border: 0; }.request-form { margin-top: 25rpx; display: grid; gap: 18rpx; }.request-form label { display: grid; gap: 8rpx; }.request-form label > text { color: #69766f; font-size: 20rpx; font-weight: 650; }.request-form picker view,.request-form input { height: 76rpx; padding: 0 20rpx; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; border: 1rpx solid #dce5e0; border-radius: 10rpx; color: #33443b; background: #fbfcfb; font-size: 22rpx; }.request-form textarea { width: 100%; height: 130rpx; padding: 18rpx 20rpx; box-sizing: border-box; border: 1rpx solid #dce5e0; border-radius: 10rpx; background: #fbfcfb; font-size: 22rpx; }.request-tip { display: block; margin-top: 18rpx; color: #8b9590; font-size: 18rpx; }.submit-request { height: 80rpx; margin-top: 22rpx; display: flex; align-items: center; justify-content: center; border-radius: 10rpx; color: white; background: #477661; font-size: 24rpx; font-weight: 650; }.submit-request::after { border: 0; }
