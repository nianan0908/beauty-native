<view wx:if="{{state}}" class="assets-page">
  <view class="assets-header"><view><text>美天会员账户</text><text class="strong">{{state.customer.name}}</text><text class="small">{{state.customer.level}} · 累计到店 {{state.customer.visits}} 次</text></view><view>{{state.customer.initial}}</view></view>
  <view class="assets-tabs"><button data-tab="coupons" class="{{tab === 'coupons' ? 'active' : ''}}" bindtap="changeTab">优惠券</button><button data-tab="cards" class="{{tab === 'cards' ? 'active' : ''}}" bindtap="changeTab">我的次卡</button><button data-tab="orders" class="{{tab === 'orders' ? 'active' : ''}}" bindtap="changeTab">消费订单</button></view>

  <view wx:if="{{tab === 'coupons'}}" class="coupon-list"><view class="asset-summary"><view>券</view><view><text class="strong">{{state.claimedCouponIds.length}} 张已领取</text><text class="small">预约时自动匹配适用优惠券</text></view></view><view wx:for="{{coupons}}" wx:key="id" class="coupon-card {{item.used ? 'used' : ''}}"><view class="coupon-value"><text class="strong">{{item.valueText}}</text><text>{{item.condition}}</text></view><view class="coupon-copy"><text>会员专享</text><text class="strong">{{item.title}}</text><text>{{item.description}}</text><text class="small">有效期至 {{item.validUntil}}</text></view><button data-id="{{item.id}}" disabled="{{item.claimed || item.used}}" bindtap="claimCoupon">{{item.used ? '已使用' : item.claimed ? '已领取' : '领取'}}</button></view></view>

  <view wx:if="{{tab === 'cards'}}" class="card-list"><view wx:for="{{state.cards}}" wx:key="id" class="member-card card-{{index}}"><view><text>{{item.status}}</text><text>美天美业</text></view><text class="strong">{{item.name}}</text><text>{{item.service}}</text><view><text class="strong">{{item.remainingTimes}}<text>/{{item.totalTimes}} 次</text></text><text>有效期至 {{item.expiresAt}}</text></view><button bindtap="goBooking">立即预约</button></view></view>

  <view wx:if="{{tab === 'orders'}}" class="order-list"><button wx:for="{{state.orders}}" wx:key="id" data-id="{{item.id}}" bindtap="openOrder"><view class="order-icon">单</view><view><text class="strong">{{item.service}}</text><text>{{item.createdAt}} · {{item.store}}</text><text class="small">{{item.employee}} · {{item.paymentMethod}}</text></view><view><text class="strong">¥{{item.payable}}</text><text>{{item.status}}</text></view><text>›</text></button></view>

  <view wx:if="{{selectedOrder}}" class="sheet-mask" bindtap="closeOrder"></view><view wx:if="{{selectedOrder}}" class="order-sheet"><view class="sheet-head"><view><text>ORDER {{selectedOrder.id}}</text><text class="strong">消费订单</text><text class="small">{{selectedOrder.createdAt}}</text></view><button bindtap="closeOrder">×</button></view><view class="order-result"><view>✓</view><view><text class="strong">{{selectedOrder.service}}</text><text>{{selectedOrder.status}} · {{selectedOrder.paymentMethod}}</text></view></view><view class="order-lines"><view><text>服务门店</text><text class="strong">{{selectedOrder.store}}</text></view><view><text>服务员工</text><text class="strong">{{selectedOrder.employee}}</text></view><view><text>项目金额</text><text class="strong">¥{{selectedOrder.amount}}</text></view><view><text>实付金额</text><text class="strong">¥{{selectedOrder.payable}}</text></view></view></view>
</view>
