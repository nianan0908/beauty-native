.assets-page { min-height: 100vh; padding: 28rpx 28rpx 60rpx; box-sizing: border-box; background: #f6f8f6; color: #2d3e35; }.strong { font-weight: 700; }.small { color: #87918c; font-size: 18rpx; }.assets-header { min-height: 160rpx; padding: 27rpx; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; border-radius: 21rpx; color: white; background: linear-gradient(135deg,#426f5b,#7f9b8c); }.assets-header > view:first-child { display: flex; flex-direction: column; gap: 7rpx; }.assets-header > view:first-child > text:first-child { color: #d7e4dd; font-size: 18rpx; letter-spacing: 2rpx; }.assets-header .strong { font-size: 34rpx; }.assets-header .small { color: #e2ebe6; font-size: 19rpx; }.assets-header > view:last-child { width: 66rpx; height: 66rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.18); font-size: 25rpx; font-weight: 700; }.assets-tabs { margin-top: 22rpx; display: grid; grid-template-columns: repeat(3,1fr); border-bottom: 1rpx solid #dce4df; }.assets-tabs button { height: 72rpx; margin: 0; padding: 0; position: relative; color: #7c8882; background: transparent; font-size: 21rpx; }.assets-tabs button::after,.coupon-card button::after,.member-card button::after,.order-list button::after { border: 0; }.assets-tabs button.active { color: #416c58; font-weight: 700; }.assets-tabs button.active::after { content: ''; position: absolute; right: 25rpx; bottom: 0; left: 25rpx; height: 4rpx; border: 0; border-radius: 2rpx; background: #477661; }.coupon-list,.card-list,.order-list { margin-top: 21rpx; display: grid; gap: 13rpx; }.asset-summary { padding: 18rpx; display: flex; align-items: center; gap: 15rpx; border-radius: 14rpx; background: #e9f1ed; }.asset-summary > view:first-child { width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; border-radius: 13rpx; color: #4d7864; background: white; font-size: 20rpx; font-weight: 70