<view wx:if="{{store}}" class="booking-page">
  <view wx:if="{{step < 4}}">
    <view class="booking-head"><button bindtap="previous">‹</button><view><text>预约服务</text><text class="small">{{store.name}}</text></view><text>{{step}} / 3</text></view>
    <view class="step-progress"><view class="{{step >= 1 ? 'active' : ''}}"></view><view class="{{step >= 2 ? 'active' : ''}}"></view><view class="{{step >= 3 ? 'active' : ''}}"></view></view>
    <view wx:if="{{activity}}" class="activity-booking"><text>{{activity.type}}</text><view><text class="strong">{{activity.title}}</text><text class="small">活动价格已锁定</text></view><text class="strong">¥{{activity.price}}</text></view>

    <view wx:if="{{step === 1}}" class="booking-step"><view class="step-copy"><text>第一步</text><text class="strong">选择服务项目</text><text class="small">以下项目均可在 {{store.name}} 预约</text></view><view class="booking-services"><button wx:for="{{services}}" wx:key="id" data-id="{{item.id}}" class="{{serviceId === item.id ? 'selected' : ''}}" bindtap="selectService"><view>{{item.initial}}</view><view><text>{{item.category}}</text><text class="strong">{{item.name}}</text><text class="small">{{item.description}} · {{item.duration}}分钟</text></view><text class="strong">¥{{item.price}}</text><text class="choice">{{serviceId === item.id ? '✓' : ''}}</text></button></view></view>

    <view wx:if="{{step === 2}}" class="booking-step"><view class="step-copy"><text>第二步</text><text class="strong">选择服务员工</text><text class="small">选择熟悉的员工，为你保留服务时间</text></view><view class="employee-list"><button wx:for="{{employees}}" wx:key="id" data-id="{{item.id}}" class="{{employeeId === item.id ? 'selected' : ''}}" bindtap="selectEmployee"><view>{{item.initial}}</view><view><text class="strong">{{item.name}}</text><text class="small">{{item.title}} · 专业认证</text></view><text>{{employeeId === item.id ? '✓' : ''}}</text></button></view></view>

    <view wx:if="{{step === 3}}" class="booking-step booking-confirm"><view class="step-copy"><text>第三步</text><text class="strong">选择到店时间</text><text class="small">确认优惠和预约信息后提交</text></view><view class="selected-service"><view><text class="strong">{{selectedService.name}}</text><text class="small">{{employees[0].name}} · {{selectedService.duration}} 分钟</text></view><text class="strong">¥{{price}}</text></view><text class="picker-title">预约日期</text><view class="date-options"><button wx:for="{{dates}}" wx:key="value" data-value="{{item.value}}" class="{{date === item.value ? 'selected' : ''}}" bindtap="selectDate"><text>{{item.week}}</text><text class="strong">{{item.day}}</text></button></view><text class="picker-title">可选时段</text><view class="time-options"><button wx:for="{{times}}" wx:key="*this" data-value="{{item}}" class="{{time === item ? 'selected' : ''}}" bindtap="selectTime">{{item}}</button></view><view wx:if="{{coupons.length && !activity}}"><text class="picker-title">使用优惠券</text><view class="coupon-options"><button data-id="" class="{{!couponId ? 'selected' : ''}}" bindtap="selectCoupon"><view><text class="strong">不使用优惠券</text><text class="small">按项目原价结算</text></view><text>{{!couponId ? '✓' : ''}}</text></button><button wx:for="{{coupons}}" wx:key="id" data-id="{{item.id}}" class="{{couponId === item.id ? 'selected' : ''}}" bindtap="selectCoupon"><view><text class="strong">{{item.title}}</text><text class="small">{{item.description}}</text></view><text>-¥{{item.discount}}</text></button></view></view><label class="booking-note"><text>到店备注（选填）</text><textarea maxlength="80" value="{{note}}" placeholder="如有特殊需求，请提前告诉我们" bindinput="inputNote" /></label></view>

    <view class="booking-bottom"><view><text>{{step === 3 ? '到店支付' : '已选项目'}}</text><text class="strong"><text wx:if="{{step === 3}}">¥{{price}}</text><text wx:else>{{selectedService.name}}</text></text></view><button bindtap="next">{{step < 3 ? '下一步' : '确认预约'}} ›</button></view>
  </view>

  <view wx:else class="booking-success"><view class="success-mark">✓</view><text>预约提交成功</text><text class="strong">{{created.dateLabel}} {{created.time}}</text><text class="small">{{created.store}} · {{created.service}}</text><view class="success-card"><view><text>服务员工</text><text class="strong">{{created.employee}}</text></view><view><text>服务时长</text><text class="strong">{{created.duration}} 分钟</text></view><view><text>到店支付</text><text class="strong">¥{{created.price}}</text></view><view><text>预约状态</text><text class="strong">{{created.status}}</text></view></view><button class="success-main" bindtap="goProfile">查看我的预约</button><button class="success-secondary" bindtap="goHome">返回首页</button></view>
</view>
