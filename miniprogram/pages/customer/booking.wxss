.booking-page { min-height: 100vh; padding: 28rpx 28rpx 145rpx; box-sizing: border-box; background: #f6f8f6; color: #2d3d35; }.strong { font-weight: 700; }.small { color: #86918b; font-size: 19rpx; }.booking-head { display: grid; grid-template-columns: 52rpx 1fr auto; align-items: center; gap: 15rpx; }.booking-head button { width: 52rpx; height: 52rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #486d5c; background: white; font-size: 38rpx; }.booking-head button::after { border: 0; }.booking-head > view { display: flex; flex-direction: column; gap: 3rpx; }.booking-head > view > text:first-child { font-size: 28rpx; font-weight: 700; }.booking-head > text { color: #6f8378; font-size: 20rpx; }.step-progress { margin-top: 23rpx; display: grid; grid-template-columns: repeat(3,1fr); gap: 8rpx; }.step-progress view { height: 5rpx; border-radius: 3rpx; background: #dce4df; }.step-progress view.active { background: #4d7964; }.activity-booking { margin-top: 19rpx; padding: 17rpx; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 13rpx; border-radius: 13rpx; color: #79523b; background: #f7e9dc; }.activity-booking > text:first-child { padding: 4rpx 8rpx; border-radius: 5rpx; background: white; font-size: 16rpx; }.activity-booking > view { display: flex; flex-direction: column; gap: 3rpx; }.activity-booking > text:last-child { font-size: 25rpx; }.booking-step { margin-top: 38rpx; }.step-copy { display: flex; flex-direction: column; gap: 8rpx; }.step-copy > text:first-child { color: #638170; font-size: 18rpx; letter-spacing: 2rpx; }.step-copy > .strong { color: #293a32; font-size: 38rpx; }.step-copy > .small { font-size: 21rpx; }.booking-services,.employee-list { margin-top: 25rpx; display: grid; gap: 13rpx; }.booking-services button { width: 100%; min-height: 130rpx; margin: 0; padding: 18rpx; display: grid; grid-template-columns: 65rpx 1fr auto 22rpx; align-items: center; gap: 14rpx; border: 2rpx solid transparent; border-radius: 16rpx; background: white; text-align: left; }.booking-services button::after,.employee-list button::after { border: 0; }.booking-services button.selected,.employee-list button.selected { border-color: #59826f; background: #f4f9f6; }.booking-services button > view:first-child { width: 62rpx; height: 62rpx; display: flex; align-items: center; justify-content: center; border-radius: 17rpx; color: #4f7966; background: #e5efea; font-size: 21rpx; font-weight: 700; }.booking-services button > view:nth-child(2) { display: flex; flex-direction: column; gap: 4rpx; }.booking-services button > view:nth-child(2) > text:first-child { color: #718178; font-size: 17rpx; }.booking-services button > view:nth-child(2) .strong { font-size: 23rpx; }.booking-services button > .strong { color: #416c58; font-size: 23rpx; }.choice { color: #4d7a65; font-size: 22rpx; }.employee-list button { width: 100%; min-height: 112rpx; margin: 0; padding: 18rpx; display: grid; grid-template-columns: 66rpx 1fr 25rpx; align-items: center; gap: 15rpx; border: 2rpx solid transparent; border-radius: 15rpx; background: white; text-align: left; }.employee-list button > view:first-child { width: 62rpx; height: 62rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #4e7864; background: #e6f0eb; font-size: 22rpx; font-weight: 700; }.employee-list button > view:nth-child(2) { display: flex; flex-direction: column; gap: 5rpx; }.employee-list button > text { color: #4d7964; }.selected-service { margin-top: 24rpx; padding: 18rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 13rpx; background: #e8f1ec; }.selected-service > view { display: flex; flex-direction: column; gap: 4rpx; }.selected-service > .strong { color: #3d6854; font-size: 27rpx; }.picker-title { display: block; margin: 28rpx 0 13rpx; color: #4c5d54; font-size: 22rpx; font-weight: 700; }.date-options { display: grid; grid-template-columns: repeat(5,1fr); gap: 8rpx; }.date-options button { height: 96rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 5rpx; border: 2rpx solid transparent; border-radius: 11rpx; color: #718078; background: white; font-size: 17rpx; }.date-options button::after,.time-options button::after,.coupon-options button::after { border: 0; }.date-options button .strong { font-size: 25rpx; }.date-options button.selected,.time-options button.selected,.coupon-options button.selected { border-color: #57816d; color: #416c57; background: #f1f7f4; }.time-options { display: grid; grid-template-columns: repeat(4,1fr); gap: 9rpx; }.time-options button { height: 64rpx; margin: 0; padding: 0; border: 2rpx solid transparent; border-radius: 9rpx; color: #617168; background: white; font-size: 20rpx; }.coupon-options { display: grid; gap: 9rpx; }.coupon-options button { min-height: 82rpx; margin: 0; padding: 13rpx 16rpx; display: flex; align-items: center; justify-content: space-between; border: 2rpx solid transparent; border-radius: 11rpx; background: white; text-align: left; }.coupon-options button > view { display: flex; flex-direction: column; gap: 3rpx; }.coupon-options button > text { color: #a35d45; font-size: 21rpx; font-weight: 700; }.booking-note { margin-top: 28rpx; display: grid; gap: 9rpx; }.booking-note > text { color: #4c5d54; font-size: 22rpx; font-weight: 700; }.booking-note textarea { width: 100%; height: 130rpx; padding: 16rpx; box-sizing: border-box; border: 1rpx solid #dce4df; border-radius: 11rpx; background: white; font-size: 21rpx; }.booking-bottom { height: calc(112rpx + env(safe-area-inset-bottom)); padding: 14rpx 28rpx env(safe-area-inset-bottom); position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; border-top: 1rpx solid #dfe6e2; background: white; }.booking-bottom > view { display: flex; flex-direction: column; gap: 4rpx; }.booking-bottom > view > text:first-child { color: #86918b; font-size: 17rpx; }.booking-bottom > view > .strong { max-width: 380rpx; overflow: hidden; color: #2f4238; font-size: 24rpx; white-space: nowrap; text-overflow: ellipsis; }.booking-bottom > button { height: 72rpx; margin: 0; padding: 0 27rpx; display: flex; align-items: center; border-radius: 36rpx; color: white; background: #477661; font-size: 23rpx; font-weight: 700; }.booking-bottom > button::after { border: 0; }.booking-success { padding-top: 100rpx; display: flex; align-items: center; flex-direction: column; text-align: center; }.success-mark { width: 100rpx; height: 100rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: white; background: #4c7b65; font-size: 45rpx; }.booking-success > text:nth-of-type(1) { margin-top: 26rpx; color: #5d6c64; font-size: 22rpx; }.booking-success > .strong { margin-top: 11rpx; color: #283a31; font-size: 36rpx; }.booking-success > .small { margin-top: 8rpx; font-size: 22rpx; }.success-card { width: 100%; margin-top: 34rpx; padding: 4rpx 20rpx; box-sizing: border-box; border-radius: 17rpx; background: white; }.success-card > view { min-height: 82rpx; display: flex; align-items: center; justify-content: space-between; border-top: 1rpx solid #e8ecea; }.success-card > view:first-child { border-top: 0; }.success-card > view > text:first-child { color: #7e8a84; font-size: 20rpx; }.success-main,.success-secondary { width: 100%; height: 80rpx; margin-top: 25rpx; border-radius: 11rpx; font-size: 23rpx; }.success-main { color: white; background: #477661; }.success-secondary { margin-top: 12rpx; color: #527163; background: white; }.success-main::after,.success-secondary::after { border: 0; }
