<view class="message-page"><view class="message-head"><view><text>MEMBER MESSAGES</text><text class="strong">消息提醒</text><text class="small">预约、活动与权益动态</text></view><button bindtap="readAll">全部已读</button></view><view class="message-list"><button wx:for="{{messages}}" wx:key="id" data-id="{{item.id}}" class="{{item.read ? 'read' : ''}}" bindtap="read"><view class="message-icon type-{{item.type}}">{{item.type.substring(0,1)}}</view><view><text class="strong">{{item.title}}</text><text>{{item.content}}</text><text class="small">{{item.createdAt}}</text></view><view wx:if="{{!item.read}}"></view></button></view></view>
