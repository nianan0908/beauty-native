<view wx:if="{{state}}" class="customer-page">
  <view class="customer-topbar"><view class="customer-brand"><view>美</view><text><text class="strong">美天美业</text><text class="small">你的专属护理空间</text></text></view><button bindtap="openMessages"><text>消息</text><view wx:if="{{unreadCount}}">{{unreadCount}}</view></button></view>

  <button class="current-store" bindtap="openStorePicker"><view><text>当前门店</text><text class="strong">{{store.name}}</text><text class="small">{{store.distance}} · {{store.shortAddress}}</text></view><text>切换 ›</text></button>

  <view class="hero-card"><view class="hero-glow"></view><text>MEITIAN BEAUTY</text><text class="strong">让每一次护理<br/>都更懂你的肌肤</text><text class="small">{{store.name}} · 专业护理</text><button bindtap="openBooking">预约服务 ›</button></view>

  <view class="home-actions"><button bindtap="openBooking"><view>约</view><text class="strong">预约服务</text><text class="small">选择项目与时间</text></button><button bindtap="openAssets"><view>卡</view><text class="strong">我的卡项</text><text class="small">{{state.cards.length}} 张使用中</text></button><button bindtap="openAssets"><view>券</view><text class="strong">会员权益</text><text class="small">优惠券与订单</text></button></view>

  <button wx:if="{{upcoming}}" class="next-booking" bindtap="openProfile"><view class="calendar-box"><text>{{upcoming.dateLabel}}</text><text class="strong">{{upcoming.time}}</text></view><view><text>下一次预约 · {{upcoming.store}}</text><text class="strong">{{upcoming.service}}</text><text class="small">{{upcoming.employee}} · {{upcoming.status}}</text></view><text>›</text></button>

  <view wx:if="{{activities.length}}" class="home-section"><view class="section-title"><view><text class="strong">门店活动</text><text>{{store.name}}专享</text></view></view><scroll-view scroll-x class="activity-scroll"><view class="activity-row"><button wx:for="{{activities}}" wx:key="id" class="activity-card activity-{{index}}" data-store="{{item.storeId}}" data-service="{{item.serviceId}}" data-activity="{{item.id}}" bindtap="openBooking"><text>{{item.type}}</text><text class="strong">{{item.title}}</text><text class="small">{{item.subtitle}}</text><view><text class="strong">¥{{item.price}}</text><text class="old-price">¥{{item.originalPrice}}</text></view><text class="book-now">马上预约 ›</text></button></view></scroll-view></view>

  <view class="home-section"><view class="section-title"><view><text class="strong">热门服务</text><text>当前门店可预约项目</text></view></view><view class="service-list"><button wx:for="{{services}}" wx:key="id" data-service="{{item.id}}" bindtap="openBooking"><view class="service-icon">{{item.category.substring(0,1)}}</view><view><text>{{item.category}}</text><text class="strong">{{item.name}}</text><text class="small">{{item.description}} · {{item.duration}} 分钟</text></view><text class="service-price">¥{{item.price}}</text><text class="row-arrow">›</text></button></view></view>

  <view class="home-section store-section"><view class="section-title"><view><text class="strong">选择门店</text><text>{{stores.length}} 家品牌门店</text></view></view><view class="store-list"><button wx:for="{{stores}}" wx:key="id" data-id="{{item.id}}" bindtap="selectStore"><view class="store-cover"><text>美</text><text>{{item.rating}}</text></view><view><text class="strong">{{item.name}}</text><text>{{item.distance}} · {{item.shortAddress}}</text><text class="small">营业时间 {{item.hours}}</text><view><text wx:for="{{item.tags}}" wx:key="*this">{{item}}</text></view></view><text>›</text></button></view></view>

  <view class="customer-bottom-space"></view><view class="customer-tabbar"><button class="active"><view>⌂</view><text>首页</text></button><button bindtap="openBooking"><view>日</view><text>预约</text></button><button bindtap="openAssets"><view>券</view><text>权益</text></button><button bindtap="openProfile"><view>我</view><text>我的</text></button></view>

  <view wx:if="{{storePickerOpen}}" class="sheet-mask" bindtap="closeStorePicker"></view><view wx:if="{{storePickerOpen}}" class="store-sheet"><view class="sheet-head"><view><text>SELECT STORE</text><text class="strong">选择服务门店</text></view><button bindtap="closeStorePicker">×</button></view><view class="sheet-store-list"><button wx:for="{{stores}}" wx:key="id" data-id="{{item.id}}" class="{{store.id === item.id ? 'selected' : ''}}" bindtap="selectStore"><view><text class="strong">{{item.name}}</text><text>{{item.distance}} · {{item.shortAddress}}</text><text class="small">{{item.hours}}</text></view><text>{{store.id === item.id ? '✓' : '›'}}</text></button></view></view>
</view>
