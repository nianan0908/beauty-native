<view wx:if="{{state}}" class="profile-page">
  <view wx:if="{{tab === 'profile'}}">
    <view class="profile-head"><view>{{state.customer.initial}}</view><view><text>个人中心</text><text class="strong">{{state.customer.name}}</text><text class="small">{{state.customer.phone}} · 已绑定手机号</text></view></view>
    <view class="brand-member-card"><view><view><text>美天美业会员</text><text class="strong">悦享会员</text><text class="small">品牌会员 · 两店通用</text></view><text>美</text></view><view class="growth"><view><text>成长值 660</text><text>距升级还差 340</text></view><view><text></text></view></view><view class="benefits"><view><text class="strong">{{state.claimedCouponIds.length}} 张券</text><text>预约自动抵扣</text></view><view><text class="strong">会员专享</text><text>门店优惠</text></view><view><text class="strong">优先预约</text><text>热门时段提醒</text></view></view></view>
    <view class="profile-stats"><button bindtap="openAppointments"><text class="strong">{{state.appointments.length}}</text><text>预约记录</text></button><button bindtap="goAssets"><text class="strong">{{state.cards[0].remainingTimes + state.cards[1].remainingTimes}}</text><text>可用卡次</text></button><button bindtap="goAssets"><text class="strong">{{state.orders.length}}</text><text>消费订单</text></button></view>
    <view class="profile-title">我的服务</view><view class="profile-menu"><button bindtap="openAppointments"><view>约</view><view><text class="strong">我的预约</text><text>查看预约进度和历史记录</text></view><text>›</text></button><button bindtap="goAssets"><view>卡</view><view><text class="strong">我的权益</text><text>查看优惠券、次卡和订单</text></view><text>›</text></button><button bindtap="goMessages"><view>信</view><view><text class="strong">消息提醒</text><text>预约、活动和权益通知</text></view><text>›</text></button></view>
    <view class="profile-title">账户与支持</view><view class="profile-menu"><button bindtap="contact"><view>客</view><view><text class="strong">联系美天</text><text>预约、卡项和退款问题</text></view><text>›</text></button><button bindtap="backEntry"><view>换</view><view><text class="strong">切换用户入口</text><text>返回会员/门店助手选择</text></view><text>›</text></button></view>
    <button class="profile-booking" bindtap="goBooking">预约新的服务</button>
  </view>

  <view wx:else class="appointments-page"><view class="appointments-head"><button bindtap="closeAppointments">‹</button><view><text class="strong">我的预约</text><text class="small">全部预约记录</text></view></view><view class="appointment-records"><button wx:for="{{state.appointments}}" wx:key="id" data-id="{{item.id}}" bindtap="openAppointment"><view><text class="strong">{{item.dateLabel}}</text><text>{{item.time}}</text></view><view><text class="appointment-status status-{{item.status}}">{{item.status}}</text><text class="strong">{{item.service}}</text><text class="small">{{item.employee}} · {{item.store}}</text></view><text>›</text></button></view></view>

  <view wx:if="{{selectedAppointment}}" class="sheet-mask" bindtap="closeAppointment"></view><view wx:if="{{selectedAppointment}}" class="appointment-sheet"><view class="sheet-head"><view><text>APPOINTMENT {{selectedAppointment.id}}</text><text class="strong">预约详情</text><text class="small">{{selectedAppointment.dateLabel}} · {{selectedAppointment.time}}</text></view><button bindtap="closeAppointment">×</button></view><view class="appointment-state"><text class="appointment-status">{{selectedAppointment.status}}</text><text class="strong">{{selectedAppointment.service}}</text><text>{{selectedAppointment.store}}</text></view><view class="appointment-lines"><view><text>服务员工</text><text class="strong">{{selectedAppointment.employee}}</text></view><view><text>服务时长</text><text class="strong">{{selectedAppointment.duration}} 分钟</text></view><view><text>到店支付</text><text class="strong">¥{{selectedAppointment.price}}</text></view><view><text>预约备注</text><text class="strong">{{selectedAppointment.note || '无'}}</text></view></view><button wx:if="{{selectedAppointment.status === '待确认' || selectedAppointment.status === '已确认'}}" class="cancel-booking" bindtap="cancelAppointment">取消预约</button></view>
</view>
