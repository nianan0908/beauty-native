.profile-page { min-height: 100vh; padding: 30rpx 28rpx 60rpx; box-sizing: border-box; background: #f6f8f6; color: #2d3e35; }.strong { font-weight: 700; }.small { color: #87918c; font-size: 18rpx; }.profile-head { display: flex; align-items: center; gap: 17rpx; }.profile-head > view:first-child { width: 78rpx; height: 78rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: white; background: #4c7964; font-size: 28rpx; font-weight: 700; }.profile-head > view:last-child { display: flex; flex-direction: column; gap: 4rpx; }.profile-head > view:last-child > text:first-child { color: #6e897a; font-size: 17rpx; letter-spacing: 2rpx; }.profile-head .strong { font-size: 31rpx; }.brand-member-card { margin-top: 27rpx; padding: 27rpx; border-radius: 22rpx; color: white; background: linear-gradient(135deg,#3f6e58,#7f9c8d); box-shadow: 0 18rpx 40rpx rgba(49,82,65,.15); }.brand-member-card > view:first-child { display: flex; justify-content: space-between; }.brand-member-card > view:first-child > view { display: flex; flex-direction: column; gap: 5rpx; }.brand-member-card > view:first-child > view > text:first-child { color: #d5e3dc; font-size: 17rpx; letter-spacing: 2rpx; }.brand-member-card > view:first-child .strong { font-size: 31rpx; }.brand-member-card > view:first-child .small { color: #dce8e1; }.brand-member-card > view:first-child > text { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(255,255,255,.35); border-radius: 50%; font-size: 23rpx; }.growth { margin-top: 28rpx; }.growth > view:first-child { display: flex; justify-content: space-between; color: #dbe7e0; font-size: 17rpx; }.growth > view:last-child { height: 7rpx; margin-top: 8rpx; overflow: hidden; border-radius: 4rpx; background: rgba(255,255,255,.2); }.growth > view:last-child text { width: 66%; height: 100%; display: block; border-radius: 4rpx; background: white; }.benefits { margin-top: 25rpx; display: grid; grid-template-columns: repeat(3,1fr); border-top: 1rpx solid rgba(255,255,255,.18); }.benefits > view { padding-top: 19rpx; display: flex; flex-direction: column; gap: 4rpx; }.benefits > view text:last-child { color: #d8e4dd; font-size: 16rpx; }.profile-stats { margin-top: 17rpx; display: grid; grid-template-columns: repeat(3,1fr); border-radius: 16rpx; background: white; }.profile-stats button { height: 100rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 4rpx; color: #7d8983; background: transparent; font-size: 18rpx; }.profile-stats button::after,.profile-menu button::after,.profile-booking::after { border: 0; }.profile-stats .strong { color: #345d4a; font-size: 27rpx; }.profile-title { margin: 34rpx 5rpx 13rpx; color: #6c7872; font-size: 20rpx; font-weight: 700; }.profile-menu { overflow: hidden; border-radius: 16rpx; background: white; }.profile-menu button { width: 100%; min-height: 104rpx; margin: 0; padding: 16rpx; display: grid; grid-template-columns: 52rpx 1fr 15rpx; align-items: center; gap: 14rpx; border-top: 1rpx solid #e7ece9; background: transparent; text-align: left; }.profile-menu button:first-child { border-top: 0; }.profile-menu button > view:first-child { width: 50rpx; height: 50rpx; display: flex; align-items: center; justify-content: center; border-radius: 13rpx; color: #4c7863; background: #e6f0eb; font-size: 18rpx; font-weight: 700; }.profile-menu button > view:nth-child(2) { display: flex; flex-direction: column; gap: 4rpx; }.profile-menu button > view:nth-child(2) .strong { font-size: 22rpx; }.profile-menu button > view:nth-child(2) text:last-child { color: #818c86; font-size: 18rpx; }.profile-menu button > text { color: #9aa39f; font-size: 26rpx; }.profile-booking { width: 100%; height: 78rpx; margin-top: 26rpx; border-radius: 12rpx; color: white; background: #477661; font-size: 23rpx; font-weight: 700; }.appointments-head { display: flex; align-items: center; gap: 15rpx; }.appointments-head button { width: 52rpx; height: 52rpx; margin: 0; padding: 0; border-radius: 50%; color: #476d5b; background: white; font-size: 37rpx; }.appointments-head button::after { border: 0; }.appointments-head > view { display: flex; flex-direction: column; gap: 3rpx; }.appointments-head .strong { font-size: 29rpx; }.appointment-records { margin-top: 25rpx; display: grid; gap: 12rpx; }.appointment-records > button { width: 100%; min-height: 122rpx; margin: 0; padding: 17rpx; display: grid; grid-template-columns: 94rpx 1fr 15rpx; align-items: center; gap: 15rpx; border-radius: 15rpx; background: white; text-align: left; }.appointment-records > button::after { border: 0; }.appointment-records > button > view:first-child { align-self: stretch; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 4rpx; border-right: 1rpx solid #e5ebe7; }.appointment-records > button > view:first-child .strong { color: #3e6653; font-size: 22rpx; }.appointment-records > button > view:first-child text:last-child { color: #7b8781; font-size: 18rpx; }.appointment-records > button > view:nth-child(2) { display: flex; flex-direction: column; gap: 5rpx; }.appointment-records > button > view:nth-child(2) .strong { font-size: 22rpx; }.appointment-status { width: fit-content; padding: 4rpx 8rpx; border-radius: 5rpx; color: #4e7864; background: #e6f0eb; font-size: 16rpx; }.status-已完成 { color: #707c76; background: #edf0ee; }.status-已取消 { color: #a05049; background: #f5e5e3; }.sheet-mask { position: fixed; z-index: 20; inset: 0; background: rgba(25,38,31,.35); }.appointment-sheet { padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 28rpx); position: fixed; z-index: 21; right: 0; bottom: 0; left: 0; border-radius: 28rpx 28rpx 0 0; background: white; }.sheet-head { display: flex; justify-content: space-between; }.sheet-head > view { display: flex; flex-direction: column; gap: 5rpx; }.sheet-head > view > text:first-child { color: #6d897a; font-size: 16rpx; letter-spacing: 2rpx; }.sheet-head .strong { font-size: 29rpx; }.sheet-head button { width: 54rpx; height: 54rpx; margin: 0; padding: 0; border-radius: 50%; color: #728079; background: #eef2f0; font-size: 31rpx; }.sheet-head button::after { border: 0; }.appointment-state { margin-top: 23rpx; padding: 18rpx; display: flex; flex-direction: column; gap: 7rpx; border-radius: 13rpx; background: #f1f6f3; }.appointment-state .strong { font-size: 26rpx; }.appointment-state > text:last-child { color: #75817b; font-size: 19rpx; }.appointment-lines { margin-top: 12rpx; }.appointment-lines > view { min-height: 72rpx; display: flex; align-items: center; justify-content: space-between; border-top: 1rpx solid #e8ecea; }.appointment-lines > view > text:first-child { color: #7c8882; font-size: 20rpx; }.appointment-lines > view > .strong { max-width: 420rpx; font-size: 20rpx; text-align: right; }.cancel-booking { height: 72rpx; margin-top: 18rpx; border-radius: 10rpx; color: #a1544c; background: #f8eae8; font-size: 21rpx; }.cancel-booking::after { border: 0; }
