.message-page { min-height: 100vh; padding: 30rpx 28rpx 60rpx; box-sizing: border-box; background: #f6f8f6; color: #2c3d34; }.strong { font-weight: 700; }.small { color: #87918c; font-size: 18rpx; }.message-head { display: flex; align-items: flex-end; justify-content: space-between; }.message-head > view { display: flex; flex-direction: column; gap: 6rpx; }.message-head > view > text:first-child { color: #6d8b7b; font-size: 17rpx; letter-spacing: 2rpx; }.message-head .strong { font-size: 36rpx; }.message-head button { margin: 0; padding: 0; color: #4c7662; background: transparent; font-size: 20rpx; }.message-head button::after,.message-list button::after { border: 0; }.message-list { margin-top: 27rpx; display: grid; gap: 12rpx; }.message-list button { width: 100%; min-height: 130rpx; margin: 0; padding: 18rpx; position: relative; display: grid; grid-template-columns: 58rpx 1fr; align-items: start; gap: 14rpx; border-radius: 15rpx; background: white; text-align: left; }.message-list button.read { opacity: .64; }.message-icon { width: 55rpx; height: 55rpx; display: flex; align-items: center; justify-content: center; border-radius: 15rpx; color: #4e7864; background: #e6f0eb; font-size: 19rpx; font-weight: 700; }.type-优惠到期 { color: #a06343; background: #f5e8dc; }.type-活动提醒 { color: #765d7d; background: #eee5ef; }.message-list button > view:nth-child(2) { display: flex; flex-direction: column; gap: 5rpx; }.message-list button > view:nth-child(2) .strong { font-size: 22rpx; }.message-list button > view:nth-child(2) > text:nth-child(2) { color: #75817b; font-size: 19rpx; line-height: 1.5; }.message-list button > view:last-child { width: 13rpx; height: 13rpx; position: absolute; top: 18rpx; right: 18rpx; border-radius: 50%; background: #b35f50; }
