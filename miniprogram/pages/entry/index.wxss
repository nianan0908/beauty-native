.entry-page { min-height: 100vh; padding: calc(env(safe-area-inset-top) + 42rpx) 38rpx 46rpx; box-sizing: border-box; position: relative; overflow: hidden; background: linear-gradient(160deg,#edf5f1 0%,#f9faf8 54%,#f3ebe3 100%); }
.ambient { position: absolute; border-radius: 50%; filter: blur(4rpx); opacity: .6; }
.ambient-one { width: 440rpx; height: 440rpx; top: -180rpx; right: -180rpx; background: #cfe4da; }
.ambient-two { width: 300rpx; height: 300rpx; bottom: 80rpx; left: -170rpx; background: #ead8ca; }
.entry-brand { position: relative; display: flex; align-items: center; gap: 18rpx; }
.brand-mark { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: white; background: #477661; font-size: 28rpx; font-weight: 700; box-shadow: 0 12rpx 30rpx rgba(51,99,78,.2); }
.entry-brand > view:last-child { display: flex; flex-direction: column; gap: 3rpx; color: #26342d; font-size: 30rpx; font-weight: 700; }
.entry-brand text { color: #779083; font-size: 17rpx; letter-spacing: 2rpx; }
.entry-copy { margin-top: 118rpx; position: relative; display: flex; flex-direction: column; gap: 22rpx; }
.entry-copy > text:first-child { color: #59816e; font-size: 21rpx; font-weight: 650; letter-spacing: 3rpx; }
.entry-copy > view { color: #22332b; font-size: 54rpx; font-weight: 720; line-height: 1.3; letter-spacing: -2rpx; }
.entry-description { color: #79857f; font-size: 25rpx; line-height: 1.7; }
.entry-options { margin-top: 72rpx; position: relative; display: grid; gap: 22rpx; }
.entry-card { width: 100%; min-height: 196rpx; margin: 0; padding: 30rpx; display: grid; grid-template-columns: 80rpx 1fr 30rpx; align-items: center; gap: 24rpx; border: 1rpx solid rgba(76,118,98,.13); border-radius: 22rpx; text-align: left; box-shadow: 0 18rpx 50rpx rgba(44,64,54,.08); }
.entry-card::after { border: 0; }
.customer-card { background: rgba(255,255,255,.93); }
.assistant-card { color: white; background: linear-gradient(135deg,#426f5b,#315b49); }
.entry-icon { width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; background: #e4f0ea; color: #48745f; font-size: 27rpx; font-weight: 700; }
.assistant-card .entry-icon { color: white; background: rgba(255,255,255,.14); }
.entry-card-copy { display: flex; flex-direction: column; gap: 8rpx; }
.entry-card-copy > text:first-child { color: #87918c; font-size: 20rpx; }
.assistant-card .entry-card-copy > text:first-child { color: #c3d7cd; }
.entry-card-copy > view { color: #26352e; font-size: 34rpx; font-weight: 700; }
.assistant-card .entry-card-copy > view { color: white; }
.entry-card-copy > text:last-child { color: #7d8983; font-size: 21rpx; }
.assistant-card .entry-card-copy > text:last-child { color: #d3e0d9; }
.entry-arrow { color: #759284; font-size: 44rpx; }
.assistant-card .entry-arrow { color: white; }
.entry-foot { position: absolute; right: 0; bottom: calc(env(safe-area-inset-bottom) + 28rpx); left: 0; color: #a0aaa5; font-size: 20rpx; text-align: center; }
