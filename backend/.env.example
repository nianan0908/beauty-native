QIGUANG_ENVIRONMENT=development
QIGUANG_DEBUG=true
QIGUANG_DATABASE_URL=postgresql+asyncpg://qiguang:qiguang@localhost:5432/qiguang
QIGUANG_REDIS_URL=redis://localhost:6379/0
QIGUANG_CORS_ORIGINS=["http://localhost:5173"]
QIGUANG_LOG_LEVEL=INFO
QIGUANG_JWT_SECRET=development-only-change-before-production
QIGUANG_ACCESS_TOKEN_MINUTES=15
QIGUANG_REFRESH_TOKEN_DAYS=14
QIGUANG_REFRESH_COOKIE_SECURE=false
QIGUANG_LOGIN_RATE_LIMIT=10
QIGUANG_LOGIN_RATE_WINDOW_SECONDS=60
